{
  "version": 1,
  "note": "The AI field's topic tree and the title rules that pick its seeds (cave-topic-seeds.mjs). Each rule is a case-insensitive regex over a corpus title; a title that matches two leaves is dropped rather than guessed. Edit a rule, rerun the picker, review the seeds it writes.",
  "parents": [
    { "id": "language", "label": "Language models", "default": "equal" },
    { "id": "agents", "label": "Agents & decisions", "default": "equal" },
    { "id": "trust", "label": "Safety & trust", "default": "equal" },
    { "id": "perception", "label": "Vision & generation", "default": "equal" },
    { "id": "methods", "label": "Methods & theory", "default": "equal" },
    { "id": "applied", "label": "Science & health", "default": "equal" }
  ],
  "leaves": [
    { "id": "llm-train", "parent": "language", "label": "LLM training & scaling", "rules": [
      { "re": "\\bpre-?train\\w*|\\bscaling laws?\\b|\\binstruction[- ]tun\\w*|\\btokeni[sz]\\w*|\\bmixture[- ]of[- ]experts\\b|\\bMoE\\b|\\bLoRA\\b|\\bfine-?tun\\w* (?:large )?language models?", "why": "Title names LLM pre-training, scaling or tuning." }
    ] },
    { "id": "reasoning", "parent": "language", "label": "Reasoning & evaluation", "rules": [
      { "re": "\\breasoning\\b|\\bchain[- ]of[- ]thought\\b|\\bmath(?:ematical)? (?:reasoning|problems?)\\b|\\btest-time (?:scaling|compute)\\b", "why": "Title names LLM reasoning." },
      { "re": "\\bbenchmark(?:ing)? (?:large )?(?:language models?|LLMs?)\\b|\\bLLM[- ]as[- ]a[- ]judge\\b", "why": "Title names an LLM benchmark." }
    ] },
    { "id": "agents", "parent": "agents", "label": "Agents & tool use", "rules": [
      { "re": "\\bagents?\\b|\\bagentic\\b|\\btool[- ](?:use|calling|augmented)\\b|\\bmulti[- ]agent\\b|\\bweb navigation\\b", "why": "Title names an agent or tool use." }
    ] },
    { "id": "rl", "parent": "agents", "label": "Reinforcement learning", "rules": [
      { "re": "\\breinforcement learning\\b|\\bpolicy (?:gradient|optimi[sz]ation)\\b|\\boffline RL\\b|\\bbandits?\\b|\\bMarkov decision\\b|\\bQ-learning\\b", "why": "Title names reinforcement learning." }
    ] },
    { "id": "safety", "parent": "trust", "label": "Alignment & safety", "rules": [
      { "re": "\\balignment\\b|\\bsafety\\b|\\bjailbreak\\w*|\\bred[- ]teaming\\b|\\bharmful\\b|\\bRLHF\\b|\\bpreference optimi[sz]ation\\b|\\bhallucinat\\w*", "why": "Title names alignment, safety or hallucination." }
    ] },
    { "id": "interp", "parent": "trust", "label": "Interpretability", "rules": [
      { "re": "\\binterpretab\\w*|\\bexplainab\\w*|\\bmechanistic\\b|\\bsparse autoencoders?\\b|\\bprobing\\b|\\bfeature attribution\\b|\\bsaliency\\b", "why": "Title names interpretability or explanation." }
    ] },
    { "id": "privacy", "parent": "trust", "label": "Privacy, fairness & robustness", "rules": [
      { "re": "\\bprivacy\\b|\\bdifferential(?:ly)? priva\\w*|\\bfederated\\b|\\bfairness\\b|\\bunlearning\\b|\\bmembership inference\\b|\\bbackdoor\\w*|\\badversarial (?:attacks?|robustness|examples?)\\b", "why": "Title names privacy, fairness or robustness." }
    ] },
    { "id": "vision", "parent": "perception", "label": "Vision & multimodal", "rules": [
      { "re": "\\bvision[- ]language\\b|\\bmultimodal\\b|\\bmulti-modal\\b|\\bVLMs?\\b|\\bobject detection\\b|\\bsegmentation\\b|\\bvideo\\b|\\bpoint clouds?\\b|\\b3D\\b|\\bimage (?:classification|recognition)\\b", "why": "Title names vision or multimodal models." }
    ] },
    { "id": "generative", "parent": "perception", "label": "Diffusion & generative models", "rules": [
      { "re": "\\bdiffusion models?\\b|\\bflow matching\\b|\\bscore[- ]based\\b|\\bimage generation\\b|\\btext-to-image\\b|\\bGANs?\\b|\\bnormali[sz]ing flows?\\b|\\bvariational autoencoders?\\b|\\bdenoising\\b", "why": "Title names a generative model." }
    ] },
    { "id": "theory", "parent": "methods", "label": "Optimisation & learning theory", "rules": [
      { "re": "\\bconvergence\\b|\\bgenerali[sz]ation bounds?\\b|\\bsample complexity\\b|\\bregret\\b|\\bstochastic gradient\\b|\\bSGD\\b|\\bprovabl\\w*|\\bminimax\\b|\\bnon-?convex\\b|\\btheoretical (?:analysis|guarantees?)\\b|\\bPAC\\b", "why": "Title names an optimisation or learning-theory result." }
    ] },
    { "id": "efficiency", "parent": "methods", "label": "Efficient training & inference", "rules": [
      { "re": "\\bquanti[sz]ation\\b|\\bpruning\\b|\\bdistillation\\b|\\befficient (?:inference|training|fine-?tuning)\\b|\\bKV[- ]cache\\b|\\bspeculative decoding\\b|\\bmodel compression\\b|\\bmemory[- ]efficient\\b|\\bsparse attention\\b", "why": "Title names an efficiency method." }
    ] },
    { "id": "graphs", "parent": "methods", "label": "Graphs, time series & tabular", "rules": [
      { "re": "\\bgraph neural\\b|\\bGNNs?\\b|\\bgraph (?:learning|representation|transformers?)\\b|\\bknowledge graphs?\\b|\\btime[- ]series\\b|\\bforecasting\\b|\\btabular\\b", "why": "Title names graphs, time series or tabular data." }
    ] },
    { "id": "science", "parent": "applied", "label": "AI for science", "rules": [
      { "re": "\\bmolecul\\w*|\\bprotein\\w*|\\bdrug\\b|\\bmaterials? (?:discovery|design|science)\\b|\\bclimate\\b|\\bweather\\b|\\bphysics-informed\\b|\\bPDEs?\\b|\\bchemi\\w*|\\bgenom\\w*|\\bsingle-cell\\b", "why": "Title names a science application." }
    ] },
    { "id": "health", "parent": "applied", "label": "Medicine & health", "rules": [
      { "re": "\\bclinical\\b|\\bmedical\\b|\\bhealthcare\\b|\\bpatients?\\b|\\bEHRs?\\b|\\bradiolog\\w*|\\bdiagnos\\w*|\\bcancer\\b|\\bECG\\b|\\bEEG\\b|\\bMRI\\b", "why": "Title names a medical application." }
    ] }
  ],
  "tags": []
}
